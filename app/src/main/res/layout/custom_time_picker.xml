<?xml version="1.0" encoding="utf-8"?>
<!-- Prilagođeni time picker - omogućava korisniku da bira sat i minut sa strelicama ili direktnim unosom -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="#1A1A1A"
    android:padding="16dp">

    <!-- Sekcija za izbor sata -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="16dp">

        <!-- Label za sat -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hour"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <!-- Dugme za povećanje sata (gore strelica) -->
        <TextView
            android:id="@+id/btn_hour_up"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:background="@null"
            android:text="▲"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <!-- Input polje za direktan unos sata (0-23) -->
        <EditText
            android:id="@+id/et_hour"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:background="@drawable/input_line_background"
            android:text="09"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="2"
            android:layout_margin="4dp" />

        <!-- Dugme za smanjenje sata (dole strelica) -->
        <TextView
            android:id="@+id/btn_hour_down"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:background="@null"
            android:text="▼"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Separator između sata i minuta (dvotačka) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=":"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginHorizontal="8dp" />

    <!-- Sekcija za izbor minuta -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginStart="16dp">

        <!-- Label za minut -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minute"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <!-- Dugme za povećanje minuta (gore strelica, skače za 15min) -->
        <TextView
            android:id="@+id/btn_minute_up"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:background="@null"
            android:text="▲"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <!-- Input polje za direktan unos minuta (0-59) -->
        <EditText
            android:id="@+id/et_minute"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:background="@drawable/input_line_background"
            android:text="00"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="2"
            android:layout_margin="4dp" />

        <!-- Dugme za smanjenje minuta (dole strelica, skače za 15min) -->
        <TextView
            android:id="@+id/btn_minute_down"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:background="@null"
            android:text="▼"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
