<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog za kreiranje/editovanje događaja - ovde korisnik unosi sve detalje za novi event -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A1A1A"
    android:padding="16dp">

    <!-- Glavni kontejner sa svim poljima za event -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Naslov događaja -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event Title"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Input za naslov (obavezno polje) -->
        <EditText
            android:id="@+id/et_event_title"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/input_line_background"
            android:hint="Enter event title"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Opis događaja -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description (Optional)"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Input za opis (opciono, multi-line) -->
        <EditText
            android:id="@+id/et_event_description"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/input_line_background"
            android:hint="Enter event description"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:padding="12dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginBottom="16dp" />

        <!-- Vreme početka -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Time"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Dugme za izbor vremena početka -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_start_time"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/button_background"
                android:text="09:00"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Checkbox za događaje koji traju više dana -->
        <CheckBox
            android:id="@+id/cb_multi_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Multi-day event"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="16dp"
            android:buttonTint="#4285F4" />

        <!-- Vreme završetka -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="End Time"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Dugme za izbor vremena završetka -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_end_time"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/button_background"
                android:text="10:00"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginEnd="8dp" />

            <!-- Dugme za izbor datuma završetka (samo za multi-day) -->
            <Button
                android:id="@+id/btn_end_date"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/button_background"
                android:text="Same day"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Prikaz trajanja događaja -->
        <TextView
            android:id="@+id/tv_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Duration: 1h"
            android:textColor="#888888"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Izbor boje događaja -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event Color"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Paleta boja za događaj -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <!-- Plava boja -->
            <View
                android:id="@+id/color_blue"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#4285F4"
                android:layout_margin="8dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Zelena boja -->
            <View
                android:id="@+id/color_green"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#34A853"
                android:layout_margin="8dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Crvena boja -->
            <View
                android:id="@+id/color_red"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#EA4335"
                android:layout_margin="8dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Narandžasta boja -->
            <View
                android:id="@+id/color_orange"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#FF9800"
                android:layout_margin="8dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Ljubičasta boja -->
            <View
                android:id="@+id/color_purple"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#9C27B0"
                android:layout_margin="8dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Dugmad za akcije -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <!-- Dugme za otkazivanje -->
            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/input_line_background"
                android:text="Cancel"
                android:textColor="#888888"
                android:textSize="14sp"
                android:layout_marginEnd="12dp"
                android:paddingHorizontal="16dp" />

            <!-- Dugme za kreiranje/čuvanje događaja -->
            <Button
                android:id="@+id/btn_create_event"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/button_background"
                android:text="Create Event"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingHorizontal="16dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
