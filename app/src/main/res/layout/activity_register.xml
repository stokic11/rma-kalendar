<?xml version="1.0" encoding="utf-8"?>
<!-- Ekran za registraciju novih korisnika - ovde se unose svi potrebni podaci za nalog -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <!-- Glavni kontejner sa scroll funkcijom zbog mnogo input polja -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="40dp"
        android:paddingTop="60dp"
        android:paddingBottom="60dp">

        <!-- Naslov sekcija -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="40dp">

            <!-- Glavni naslov -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create Account"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Podnaslov -->
            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Join us today"
                android:textColor="#808080"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Sva input polja za registraciju -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="30dp">

            <!-- Polje za ime -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="25dp">

                <!-- Label za ime -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="First Name"
                    android:textColor="#d4006d"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Input za ime -->
                <EditText
                    android:id="@+id/et_first_name"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/input_line_background"
                    android:hint="Enter first name"
                    android:inputType="textPersonName"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingBottom="8dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#808080"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Polje za prezime -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="25dp">

                <!-- Label za prezime -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last Name"
                    android:textColor="#d4006d"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Input za prezime -->
                <EditText
                    android:id="@+id/et_last_name"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/input_line_background"
                    android:hint="Enter last name"
                    android:inputType="textPersonName"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingBottom="8dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#808080"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Polje za datum rođenja -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="25dp">

                <!-- Label za rođendan -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Birthday"
                    android:textColor="#d4006d"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Input za rođendan (otvara date picker kada se klikne) -->
                <EditText
                    android:id="@+id/et_birthday"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/input_line_background"
                    android:hint="Select birthday"
                    android:focusable="false"
                    android:clickable="true"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingBottom="8dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#808080"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Polje za korisničko ime -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="25dp">

                <!-- Label za username -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Username"
                    android:textColor="#d4006d"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Input za username (mora biti jedinstveno) -->
                <EditText
                    android:id="@+id/et_username"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/input_line_background"
                    android:hint="Choose username"
                    android:inputType="text"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingBottom="8dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#808080"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Polje za lozinku -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="25dp">

                <!-- Label za password -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textColor="#d4006d"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Input za password (sakriveno) -->
                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/input_line_background"
                    android:hint="Create password"
                    android:inputType="textPassword"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingBottom="8dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#808080"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Polje za potvrdu lozinke -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="35dp">

                <!-- Label za potvrdu password-a -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirm Password"
                    android:textColor="#d4006d"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Input za potvrdu password-a (mora da se slaže sa password-om) -->
                <EditText
                    android:id="@+id/et_confirm_password"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/input_line_background"
                    android:hint="Confirm password"
                    android:inputType="textPassword"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingBottom="8dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#808080"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Dugme za kreiranje naloga -->
            <Button
                android:id="@+id/btn_register"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/button_background"
                android:text="CREATE ACCOUNT"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="30dp" />

        </LinearLayout>

        <!-- Link za vraćanje na login ako korisnik već ima nalog -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Obični tekst -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textColor="#808080"
                android:textSize="14sp" />

            <!-- Klikabilan link za login -->
            <TextView
                android:id="@+id/tv_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign In"
                android:textColor="#d4006d"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
